{
  "name": "nexus-mcp-oss",
  "version": "1.0.0",
  "description": "Open-source Nexus MCP observability and control server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mcp": "tsx src/mcp-bridge.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcp-bridge.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/benchmark.test.ts tests/compress.test.ts",
    "bench:compare": "tsx tests/compare-suite.ts",
    "bench:real": "tsx tests/compare-suite.ts --eval-set ../chatp/bench_data/eval_sets/starter.jsonl"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "js-tiktoken": "^1.0.21",
    "morgan": "^1.10.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
